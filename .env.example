# Google Cloud OAuth 2.0 Credentials
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# OAuth Redirect URI (Must match Google Cloud Console)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# App Secret for session encryption (Optional/Defaults to local dev key)
SESSION_SECRET=dev-secret-key-change-in-production

# Dynamic Google Health API Version (Change to v5 or v6 when released)
GOOGLE_HEALTH_API_VERSION=v4

# AI Health Assistant (LLM Provider Keys)
# NVIDIA NIM
# NVIDIA_API_KEY=nvapi-your-key-here
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Optional quicker model for picking tools; answers always use NVIDIA_MODEL.
# NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Google Gemini
# GEMINI_API_KEY=AIzaSy-your-key-here
# GEMINI_MODEL=gemini-2.5-flash
# With GEMINI_API_KEY set, "Gemini 4 Hydrogen" (gemini-4-hydrogen) can be picked in the chat's model menu.

# OpenAI or Custom Compatible Provider
# LLM_PROVIDER=nvidia
# LLM_API_KEY=your-api-key
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Database (Optional)
# Postgres (Neon, Supabase, local, ...). Without it the app keeps only the live 7-day window.
# `npm run build` applies migrations when it is set; run `npm run db:migrate` to apply them by hand.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Protects /api/cron/sync. Vercel Cron sends it as a Bearer token.
# CRON_SECRET=generate-with-openssl-rand-hex-32

# Comma-separated Google account emails allowed to open /admin. Unset means nobody can.
# ADMIN_EMAILS=you@example.com
